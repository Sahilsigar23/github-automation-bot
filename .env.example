# ---------------------------------------------------------------------------
# github-automation-bot — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection used by Prisma Migrate. On Neon this is the
# same host without the "-pooler" segment. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- GitHub OAuth App -------------------------------------------------------
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- GitHub Webhooks --------------------------------------------------------
# A long random string. The SAME value is set on the GitHub webhook config and
# used here to verify the HMAC-SHA256 signature of every delivery.
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=""

# --- Auth.js / NextAuth -----------------------------------------------------
# Session/JWT signing secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public base URL of the app (no trailing slash).
# Local: http://localhost:3000   Prod: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Token encryption at rest ----------------------------------------------
# 32-byte key (hex = 64 chars) used for AES-256-GCM encryption of stored
# GitHub access tokens and per-user Slack URLs. Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Slack Incoming Webhook (optional, global default) ---------------------
# Create at: https://api.slack.com/messaging/webhooks
# Users may also set a personal webhook URL from the Settings page.
SLACK_WEBHOOK_URL=""

# --- Google Gemini (optional AI enrichment) --------------------------------
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Model id (default shown). Free tier friendly.
GEMINI_MODEL="gemini-2.0-flash"

# --- Cron / background retry (optional) ------------------------------------
# Bearer secret protecting POST /api/cron/retry. Generate: openssl rand -hex 24
# On Vercel Cron this is sent automatically via the CRON_SECRET convention.
CRON_SECRET=""
